# Google Gemini (server-side only — never NEXT_PUBLIC_)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: tried once after primary model exhausts 429/503 retries
GEMINI_FALLBACK_MODEL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Project Settings → API → service_role (secret). Never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for POST /api/ingest (bookmarklet / extension)
INGEST_TOKEN=

